@model List<CarBrandListItem>

@{
    ViewData["Title"] = "Бренды";
}


<div class="text-center my-5">
    <h1 class="display-4 fw-bold text-white">Наши <span class="text-danger">Бренды</span></h1>
    <p class="text-secondary lead opacity-75">Выберите производителя для просмотра доступного модельного ряда</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-dark text-center border-0 shadow-sm rounded-4 py-4 dark-alert" role="alert">
        <i class="bi bi-info-circle fs-3 d-block mb-2 text-danger"></i>
        <span class="text-secondary">Бренды пока не добавлены в каталог.</span>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
        @foreach (var brand in Model)
        {
            var logoSrc = string.IsNullOrEmpty(brand.LogoUrl) ? "/ImagePlaceholder.jpg" : brand.LogoUrl;

            <div class="col">
                <div class="card h-100 border-0 shadow-sm brand-card position-relative overflow-hidden rounded-4">

                    <div class="brand-logo-wrapper d-flex align-items-center justify-content-center p-4 rounded-top">
                        <img src="@logoSrc"
                             class="img-fluid brand-logo"
                             onerror="this.onerror=null;this.src='/ImagePlaceholder.jpg'"
                             alt="@brand.Name logo" />
                    </div>

 
                    <div class="card-body d-flex flex-column text-center p-4">
                        <h4 class="card-title fw-bold text-white mb-2">@brand.Name</h4>
                        <p class="card-text text-secondary flex-grow-1 fs-6">
                            @(string.IsNullOrWhiteSpace(brand.Description) ? "Описание отсутствует." : brand.Description)
                        </p>
                    </div>


                    <div class="card-footer bg-transparent border-0 p-4 pt-0">
                        <a asp-controller="CarBrands"
                               asp-action="Details"
                               asp-route-id="@brand.Id"
                               class="btn btn-outline-danger w-100 rounded-pill fw-semibold py-2 transition-btn">
                            Смотреть модели &rarr;
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}


<style>
    .brand-card {
        background-color: #16171a;
        border: 1px solid #2a2c30 !important;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

        .brand-card:hover {
            transform: translateY(-6px);
            border-color: #dc3545 !important;
            box-shadow: 0 12px 24px rgba(220, 53, 69, 0.18) !important;
        }

    .brand-logo-wrapper {
        height: 180px;
        background: linear-gradient(180deg, #0f0f11 0%, #16171a 100%);
        border-bottom: 1px solid #2a2c30;
    }

    .brand-logo {
        max-height: 120px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .brand-card:hover .brand-logo {
        transform: scale(1.05);
    }

    .btn-outline-danger {
        color: #ff5252;
        border-color: #dc3545;
    }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }

    .dark-alert {
        background-color: #16171a;
        border: 1px solid #2a2c30;
    }
</style>