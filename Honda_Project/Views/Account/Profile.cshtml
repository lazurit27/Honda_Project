@model Honda_Project.ViewsModels.Accounts.AccountProfile

@{
    ViewData["Title"] = "Профиль пользователя";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-dark border-secondary text-white shadow rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-circle text-danger display-1"></i>
                    </div>
                    <h3 class="card-title mb-4">Профиль пользователя</h3>

                    <div class="list-group list-group-flush text-start mb-4">
                        <div class="list-group-item bg-transparent text-white border-secondary d-flex justify-content-between align-items-center">
                            <span class="text-white-50">ID пользователя:</span>
                            <span class="fw-bold">@Model.UserId</span>
                        </div>
                        <div class="list-group-item bg-transparent text-white border-secondary d-flex justify-content-between align-items-center">
                            <span class="text-white-50">Email:</span>
                            <span class="fw-bold">@Model.Email</span>
                        </div>
                        <div class="list-group-item bg-transparent text-white border-secondary d-flex justify-content-between align-items-center">
                            <span class="text-white-50">Роль:</span>
                            <span class="badge bg-danger fs-6 rounded-pill">@Model.Role</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="ChangePassword" class="btn btn-outline-light rounded-pill">Изменить пароль</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary rounded-pill">На главную</a>
                        <a asp-controller="Order" asp-action="Index" asp-route-userId="@Model.UserId" class="btn btn-secondary rounded-pill">заказы</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>