@model Honda_Project.ViewsModels.Accounts.AccountChangePassword

@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-dark border-secondary text-white shadow rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4">Смена пароля</h3>

                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label">Текущий пароль</label>
                            <input asp-for="OldPassword" type="password" class="form-control bg-secondary text-white border-0" placeholder="Введите старый пароль" />
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                            <input asp-for="NewPassword" type="password" class="form-control bg-secondary text-white border-0" placeholder="Введите новый пароль" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Подтверждение нового пароля</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control bg-secondary text-white border-0" placeholder="Повторите новый пароль" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger rounded-pill fw-bold">Сохранить изменения</button>
                            <a asp-action="GetCurrentUser" class="btn btn-outline-light rounded-pill">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}