@using Honda_Project.Areas.Admin.ViewsModels
@model List<Honda_Project.Areas.Admin.ViewsModels.OrderRow>

@{
    ViewData["Title"] = "Просмотр заказов";
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden admin-table-card">
    <div class="card-header bg-transparent border-secondary p-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold text-white mb-1">Orders</h4>
            <p class="text-secondary mb-0 fs-7">История ваших заказов</p>
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0 custom-admin-table">
            <thead>
                <tr class="text-secondary text-uppercase fs-7 border-secondary">
                    <th scope="col" style="width: 100px;">Order ID</th>
                    <th scope="col">User Name</th>
                    <th scope="col">Product ID</th>
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-secondary">
                            Заказы пока отсутствуют.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr class="border-secondary">
                            <td>
                                <span class="fw-bold text-white fs-6">#@order.Id</span>
                            </td>

                            <td>
                                <span class="text-white fw-semibold">@order.UserName</span>
                            </td>

                            <td>
                                <a asp-area="" 
                                   asp-controller="CarProducts" 
                                   asp-action="Details" 
                                   asp-route-id="@order.ProductId" 
                                   class="text-danger text-decoration-none fw-bold" 
                                   target="_blank">
                                    Product #@order.ProductId <i class="bi bi-box-arrow-up-right fs-7 ms-1"></i>
                                </a>
                            </td>

                            <td>
                                <span class="text-secondary">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </td>

                            <td>
                                @{
                                    var statusColor = order.Status.ToString().ToLower() switch
                                    {
                                        "completed" => "bg-success text-white",
                                        "pending" => "bg-warning text-dark",
                                        "canceled" or "cancelled" => "bg-danger text-white",
                                        "inprogress" or "inprocess" => "bg-primary text-white",
                                        _ => "bg-secondary text-white"
                                    };
                                }
                                <span class="badge rounded-pill px-3 py-2 fw-medium @statusColor">
                                    @order.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>