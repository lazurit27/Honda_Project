@model Honda_Project.Models.CarProduct

@{
    ViewData["Title"] = "Подтверждение заказа";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 text-white bg-dark">
                <h3 class="fw-bold mb-4 text-center">Подтверждение покупки</h3>

                <div class="d-flex align-items-center gap-3 mb-4 p-3 border border-secondary rounded-3">
                    <img src="@(string.IsNullOrEmpty(Model.MainImageUrl) ? "/ImagePlaceholder.jpg" : Model.MainImageUrl)"
                         alt="@Model.Title"
                         class="rounded object-fit-cover"
                         style="width: 100px; height: 75px;" />
                    <div>
                        <h5 class="mb-1 text-white">@Model.Title</h5>
                        <span class="text-secondary d-block">Год: @Model.Year</span>
                        <span class="fw-bold text-danger fs-5">$@Model.Price.ToString("N0")</span>
                    </div>
                </div>

                <div class="alert alert-warning border-0 text-dark mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Пожалуйста, проверьте детали заказа перед подтверждением.
                </div>

                <form asp-controller="Order" asp-action="CreateConfirmed" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                        <a asp-controller="CarProducts" asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary rounded-pill px-4">
                            Отмена
                        </a>
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 fw-semibold">
                            Подтвердить заказ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>