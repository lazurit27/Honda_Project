@model CarProductListItem
@if (Model.IsAvailable)
            {
<div class="col">
    <div class="card h-100 border-secondary bg-dark text-white shadow-lg rounded-4 overflow-hidden position-relative product-card">
                    
        <div class="position-absolute top-0 end-0 m-3 z-2">
            
                <span class="badge bg-success bg-opacity-75 backdrop-blur px-3 py-2 rounded-pill">
                    <i class="bi bi-check-circle me-1"></i>В наличии
                </span>
            
            
        </div>

        <div class="product-image-wrapper position-relative overflow-hidden bg-black d-flex align-items-center justify-content-center p-3">
            <img src="@Model.MainImageUrl"
                 class="product-img"
                 onerror="this.onerror=null;this.src='/ImagePlaceholder.jpg'"
                 alt="@Model.Title" />
        </div>

        <div class="card-body d-flex flex-column p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title fw-bold text-white m-0 text-truncate" title="@Model.Title">@Model.Title</h5>
                <span class="badge bg-dark border border-secondary text-light ms-2 px-2 py-1 fs-7">
                    <i class="bi bi-calendar-event me-1"></i>@Model.Year г.
                </span>
            </div>
                        
           <p class="card-text text-white-50 mb-3">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "Описание отсутствует." : Model.Description)
            </p>

            <div class="mt-auto pt-2 border-top border-secondary d-flex align-items-center justify-content-between">
                <span class="text-white-50">Цена:</span>
                <span class="fs-4 fw-bold text-danger">@Model.Price.ToString("N0") $</span>
            </div>
        </div>

        <div class="card-footer bg-transparent border-0 p-4 pt-0">
            <a asp-controller="CarProducts"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger w-100 rounded-pill fw-semibold py-2 transition-btn">
                Подробнее <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>
}