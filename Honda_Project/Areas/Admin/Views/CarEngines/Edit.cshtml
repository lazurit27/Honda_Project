@using Honda_Project.Enums
@model Honda_Project.Areas.Admin.ViewsModels.EngineEdit

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Редактирование двигателя";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark text-white shadow-lg border-secondary rounded-4">
                <div class="card-header border-secondary bg-transparent p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="fw-bold mb-1 text-white">
                            <i class="bi bi-pencil-square me-2 text-danger"></i>Редактировать двигатель
                        </h3>
                        <p class="text-muted mb-0 fs-7">Изменение параметров двигателя</p>
                    </div>
                    <span class="badge bg-danger px-3 py-2 fs-7">ID: @Model.Id</span>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label text-light fw-semibold">
                                <i class="bi bi-tag me-1 text-danger"></i>Название двигателя
                            </label>
                            <input asp-for="Name" class="form-control custom-input" placeholder="Например: 1.8 i-VTEC (R18A)" />
                            <span asp-validation-for="Name" class="text-danger fs-7 mt-1 d-block"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Volume" class="form-label text-light fw-semibold">
                                    <i class="bi bi-speedometer2 me-1 text-danger"></i>Объём двигателя (л)
                                </label>
                                <input asp-for="Volume" class="form-control custom-input" type="number" step="0.1" placeholder="1.8" />
                                <span asp-validation-for="Volume" class="text-danger fs-7 mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Horsepower" class="form-label text-light fw-semibold">
                                    <i class="bi bi-lightning-charge me-1 text-danger"></i>Мощность (л.с.)
                                </label>
                                <input asp-for="Horsepower" class="form-control custom-input" type="number" placeholder="140" />
                                <span asp-validation-for="Horsepower" class="text-danger fs-7 mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FuelType" class="form-label text-light fw-semibold">
                                <i class="bi bi-fuel-pump me-1 text-danger"></i>Тип топлива
                            </label>
                            <select asp-for="FuelType" asp-items="Html.GetEnumSelectList<FuelType>()" class="form-select custom-input">
                                <option value="" disabled>-- Выберите тип топлива --</option>
                            </select>
                            <span asp-validation-for="FuelType" class="text-danger fs-7 mt-1 d-block"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-3 border-top border-secondary">
                            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i>Отмена
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold">
                                <i class="bi bi-check-lg me-1"></i>Сохранить изменения
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}