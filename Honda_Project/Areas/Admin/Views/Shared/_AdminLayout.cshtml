<!DOCTYPE html>
<html lang="ru" style="background-color: #0d0e10;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #0d0e10 !important; color: #ffffff;">

    <div class="d-flex min-vh-100" style="background-color: #0d0e10;">

        <aside class="admin-sidebar p-3 border-end border-secondary" style="width: 250px; background-color: #121315;">
            <div class="d-flex align-items-center mb-4 px-2">
                <i class="bi bi-shield-lock-fill text-danger fs-3 me-2"></i>
                <span class="fs-5 fw-bold text-white">Admin Panel</span>
            </div>

            <nav class="nav nav-pills flex-column gap-1">
                <a asp-controller="CarBrands" asp-action="Index" 
                   class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CarBrands" ? "active" : "")">
                    <i class="bi bi-tags me-2"></i>Car Brands
                </a>
                <a asp-controller="CarModels" asp-action="Index" 
                   class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CarModels" ? "active" : "")">
                    <i class="bi bi-car-front me-2"></i>Car Models
                </a>
                <a asp-controller="CarProducts" asp-action="Index" 
                   class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CarProducts" ? "active" : "")">
                    <i class="bi bi-box-seam me-2"></i>Car Products
                </a>
                <a asp-controller="CarEngines" asp-action="Index" 
                   class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CarEngines" ? "active" : "")">
                    <i class="bi bi-key-fill me-2"></i>Car Engines
                </a>
                <a asp-controller="CarBody" asp-action="Index" 
                   class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CarBody" ? "active" : "")">
                    <i class="bi bi-minecart me-2"></i>Car Body
                </a>
                <a asp-controller="Orders" asp-action="Index" 
                   class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")">
                    <i class="bi bi-people me-2"></i>Orders
                </a>
            </nav>

            <hr class="border-secondary my-4" />

            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link text-danger">
                <i class="bi bi-box-arrow-left me-2"></i>Exit to Site
            </a>
        </aside>


        <main class="admin-content flex-grow-1 p-4" style="background-color: #0d0d0e;">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>