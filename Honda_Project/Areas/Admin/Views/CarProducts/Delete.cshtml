@model CarProduct

@{
    ViewData["Title"] = "Delete Car Product";
}

<div class="d-flex align-items-center justify-content-between my-4">
    <a asp-area="Admin" asp-controller="CarProducts" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 btn-back">
        &larr; Back to Products List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-danger border-opacity-25 shadow-lg bg-dark rounded-4 p-4">
            

            <div class="d-flex align-items-center gap-3 border-bottom border-secondary border-opacity-25 pb-3 mb-4">
                <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold text-white mb-0">Confirm Deletion</h3>
                    <p class="text-danger mb-0 small">Are you sure you want to permanently delete this car product?</p>
                </div>
            </div>

            <div class="row g-4 align-items-center mb-4">
                <div class="col-md-5 text-center">
                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <img src="@Model.MainImageUrl" alt="@Model.Title" class="img-fluid rounded-3 border border-secondary shadow-sm object-fit-cover" style="max-height: 200px; width: 100%;" />
                    }
                    else
                    {
                        <div class="bg-secondary bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center p-4 text-white-50 border border-secondary" style="height: 180px;">
                            <i class="bi bi-car-front display-4"></i>
                        </div>
                    }
                </div>

                <div class="col-md-7">
                    <h4 class="fw-bold text-white mb-2">@Model.Title</h4>
                    
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-secondary border border-secondary text-light px-3 py-2">
                            <i class="bi bi-calendar3 me-1"></i> @Model.Year
                        </span>
                        <span class="badge bg-danger text-white px-3 py-2 fw-bold">
                            $@Model.Price.ToString("N0")
                        </span>
                    </div>

                    <ul class="list-unstyled text-white-50 small mb-0">
                        <li class="mb-1"><strong class="text-light">Color:</strong> @(Model.Color ?? "N/A")</li>
                        <li class="mb-1"><strong class="text-light">Transmission:</strong> @Model.Transmission</li>
                        <li class="mb-1"><strong class="text-light">Drive Type:</strong> @Model.Drive</li>
                    </ul>
                </div>
            </div>


            <form asp-area="Admin" asp-controller="CarProducts" asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="d-flex justify-content-end gap-3 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-area="Admin" asp-controller="CarProducts" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-trash-fill"></i> Delete Permanently
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>