@using Honda_Project.Areas.Admin.ViewsModels
@model CarModelCreate

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Создание модели";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark text-white shadow-lg border-secondary rounded-4">
                <div class="card-header border-secondary bg-transparent p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="fw-bold mb-1 text-white">
                            <i class="bi bi-car-front-fill me-2 text-danger"></i>Создать модель
                        </h3>
                        <p class="text-muted mb-0 fs-7">Добавление новой автомобильной модели в каталог</p>
                    </div>
                    <span class="badge bg-danger px-3 py-2 fs-7">Модель</span>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="BrandId" class="form-label text-light fw-semibold">
                                <i class="bi bi-patch-check me-1 text-danger"></i>Бренд
                            </label>
                            <select asp-for="BrandId" asp-items="Model.Brands" class="form-select custom-input">
                                <option value="" disabled selected>-- Выберите бренд --</option>
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger fs-7 mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label text-light fw-semibold">
                                <i class="bi bi-tag me-1 text-danger"></i>Название модели
                            </label>
                            <input asp-for="Name" class="form-control custom-input" placeholder="Например: Civic, Accord, CR-V" />
                            <span asp-validation-for="Name" class="text-danger fs-7 mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ModelLogoFile" class="form-label text-light fw-semibold">
                                <i class="bi bi-image me-1 text-danger"></i>Логотип / Изображение модели
                            </label>
                            <input asp-for="ModelLogoFile" type="file" accept="image/*" class="form-control custom-input" />
                            <span asp-validation-for="ModelLogoFile" class="text-danger fs-7 mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label text-light fw-semibold">
                                <i class="bi bi-card-text me-1 text-danger"></i>Описание
                            </label>
                            <textarea asp-for="Description" class="form-control custom-input" rows="4" placeholder="Краткая история или описание модели..."></textarea>
                            <span asp-validation-for="Description" class="text-danger fs-7 mt-1 d-block"></span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-3 border-top border-secondary">
                            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i>Отмена
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold">
                                <i class="bi bi-check-lg me-1"></i>Сохранить модель
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}