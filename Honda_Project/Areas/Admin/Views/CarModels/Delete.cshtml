@using Honda_Project.Areas.Admin.ViewsModels
@model CarModelDelete

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Удаление модели";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card bg-dark text-white shadow-lg border-danger rounded-4">
                <div class="card-header border-danger bg-danger bg-opacity-10 p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1 text-danger fw-bold">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Удаление модели
                        </h4>
                        <p class="text-muted mb-0 fs-7">Вы действительно хотите безвозвратно удалить эту модель?</p>
                    </div>
                    <span class="badge bg-danger px-3 py-2 fs-7">ID: @Model.Id</span>
                </div>

                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 p-3 rounded-3 mb-4 model-info-box">
                        @if (!string.IsNullOrEmpty(Model.ModelLogoUrl))
                        {
                            <img src="@Model.ModelLogoUrl" alt="@Model.Name logo" class="model-logo-preview rounded-2" />
                        }
                        else
                        {
                            <div class="model-logo-placeholder rounded-2 d-flex align-items-center justify-content-center">
                                <i class="bi bi-car-front-fill text-secondary fs-4"></i>
                            </div>
                        }
                        <div>
                            <h5 class="fw-bold text-white mb-0">@Model.Name</h5>
                            <span class="text-muted fs-7">Модель автомобиля</span>
                        </div>
                    </div>


                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-light rounded-3 p-3 mb-4">
                        <h6 class="text-danger fw-bold mb-2 fs-7">
                            <i class="bi bi-shield-exclamation me-1"></i>
                            Внимание! Вместе с моделью будут удалены следующие элементы:
                        </h6>
                        <ul class="mb-0 fs-7 ps-3 text-white-50">
                            <li>
                                <strong class="text-white">Автомобили (@Model.CarProductsNames.Count):</strong>
                                @(Model.CarProductsNames.Any() ? string.Join(", ", Model.CarProductsNames) : "Нет")
                            </li>
                        </ul>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex align-items-center justify-content-between pt-3 border-top border-secondary">
                            <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i>Отмена
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-bold">
                                <i class="bi bi-trash-fill me-1"></i>Подтвердить удаление
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

