@using Honda_Project.Enums
@model OrderEdit

@{
    ViewData["Title"] = "Редактирование статуса заказа";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h4 class="fw-bold mb-0">Update Order Status</h4>
                    <span class="badge bg-secondary fs-6 px-3 py-2 rounded-pill">#@Model.Id</span>
                </div>

                <form asp-area="Admin" asp-controller="Orders" asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label asp-for="Status" class="form-label text-secondary fw-semibold">Order Status</label>
                        <select asp-for="Status" 
                                asp-items="Html.GetEnumSelectList<OrderStatus>()" 
                                class="form-select form-select-lg bg-dark text-white border-secondary rounded-3">
                        </select>
                        <span asp-validation-for="Status" class="text-danger small ms-1"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-area="Admin" asp-controller="Order" asp-action="Index" 
                           class="btn btn-outline-secondary rounded-pill px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>