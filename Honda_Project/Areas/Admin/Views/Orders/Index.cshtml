@model List<Honda_Project.Areas.Admin.ViewsModels.OrderRow>

@{
    ViewData["Title"] = "Управление заказами";
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden admin-table-card">
    <div class="card-header bg-transparent border-secondary p-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold text-white mb-1">Order Management</h4>
            <p class="text-secondary mb-0 fs-7">Manage and update customer orders</p>
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0 custom-admin-table">
            <thead>
                <tr class="text-secondary text-uppercase fs-7 border-secondary">
                    <th scope="col" style="width: 100px;">Order ID</th>
                    <th scope="col">User Name</th>
                    <th scope="col">Product ID</th>
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end pe-4" style="width: 120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-secondary">
                            Заказы пока отсутствуют.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr class="border-secondary">
                            <td>
                                <span class="fw-bold text-white fs-6">#@order.Id</span>
                            </td>

                            <td>
                                <span class="text-white fw-semibold">@order.UserName</span>
                            </td>

                            <td>
                                <a asp-area="" asp-controller="CarProducts" asp-action="Details" asp-route-id="@order.ProductId" 
                                   class="text-danger text-decoration-none fw-bold" target="_blank">
                                    Product #@order.ProductId <i class="bi bi-box-arrow-up-right fs-7 ms-1"></i>
                                </a>
                            </td>

                            <td>
                                <span class="text-secondary">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </td>

                            <td>
                                @{
                                var statusColor = order.Status.ToString() switch
                                {
                                "Completed" => "bg-success text-white",
                                "Pending" => "bg-warning text-dark",
                                "canceled" => "bg-danger text-white",
                                "inProgress" => "bg-primary text-white",
                                _ => "bg-secondary text-white"
                                };
                                }
    <span class="badge rounded-pill px-3 py-2 fw-medium @statusColor">
        @order.Status
    </span>
</td>

                            <td class="text-end pe-4">
                                <a asp-area="Admin"
                                   asp-controller="Orders"
                                   asp-action="Edit"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-outline-warning rounded-3"
                                   title="Edit">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>